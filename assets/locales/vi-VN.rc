LANGUAGE 42, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Tệp"
    BEGIN
        MENUITEM "&Mới\tCtrl+N", ID_FILE_NEW
        MENUITEM "M&ở...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Lưu\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Lưu &dưới dạng...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&In...\tCtrl+P", ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "T&hoát", ID_FILE_EXIT
    END
    POPUP "&Chỉnh sửa"
    BEGIN
        MENUITEM "&Hoàn tác\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "C&ắt\tCtrl+X", ID_EDIT_CUT
        MENUITEM "&Sao chép\tCtrl+C", ID_EDIT_COPY
        MENUITEM "&Dán\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "&Xóa\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Tìm...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "Tìm t&iếp\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "Tìm t&rước\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "Tha&y thế...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "&Đi tới...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Chọn tất &cả\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "Giờ/&Ngày\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "Định &dạng"
    BEGIN
        MENUITEM "&Tự động xuống dòng", ID_FORMAT_WRAP
        MENUITEM "&Phông chữ...", ID_FORMAT_FONT
    END
    POPUP "&Xem"
    BEGIN
        POPUP "&Thu phóng"
        BEGIN
            MENUITEM "Phóng &to\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "Thu &nhỏ\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "&Khôi phục thu phóng mặc định\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "Tha&nh trạng thái", ID_VIEW_STATUS
    END
    POPUP "T&rợ giúp"
    BEGIN
        MENUITEM "&Giới thiệu về Notepad Classic", ID_HELP_ABOUT
    END
END

