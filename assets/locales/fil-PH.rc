LANGUAGE 100, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Bago\tCtrl+N", ID_FILE_NEW
        MENUITEM "B&uksan...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&I-save\tCtrl+S", ID_FILE_SAVE
        MENUITEM "I-save bi&lang...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "I-pri&nt...\tCtrl+P", ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "Lu&mabas", ID_FILE_EXIT
    END
    POPUP "&I-edit"
    BEGIN
        MENUITEM "&I-undo\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "&Gupit\tCtrl+X", ID_EDIT_CUT
        MENUITEM "&Kopya\tCtrl+C", ID_EDIT_COPY
        MENUITEM "I-p&aste\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "&Burahin\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Hanapin...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "Hanapin ang &susunod\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "Hanapin ang &nakaraan\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "&Palitan...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "Pum&unta sa...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Piliin ang &lahat\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "&Oras/Petsa\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "P&ormat"
    BEGIN
        MENUITEM "I-&wrap ang mga salita", ID_FORMAT_WRAP
        MENUITEM "&Font...", ID_FORMAT_FONT
    END
    POPUP "&Tingnan"
    BEGIN
        POPUP "&Zoom"
        BEGIN
            MENUITEM "Palaki&hin\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "Pali&itin\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "Ibalik ang &default na zoom\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "&Status bar", ID_VIEW_STATUS
    END
    POPUP "T&ulong"
    BEGIN
        MENUITEM "&Tungkol sa Notepad Classic", ID_HELP_ABOUT
    END
END

