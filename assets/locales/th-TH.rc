LANGUAGE 30, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "แฟ้ม(&F)"
    BEGIN
        MENUITEM "สร้างใหม่(&N)\tCtrl+N", ID_FILE_NEW
        MENUITEM "เปิด(&O)...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "บันทึก(&S)\tCtrl+S", ID_FILE_SAVE
        MENUITEM "บันทึกเป็น(&A)...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "พิมพ์(&P)...\tCtrl+P", ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "ออก(&X)", ID_FILE_EXIT
    END
    POPUP "แก้ไข(&E)"
    BEGIN
        MENUITEM "เลิกทำ(&U)\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "ตัด(&T)\tCtrl+X", ID_EDIT_CUT
        MENUITEM "คัดลอก(&C)\tCtrl+C", ID_EDIT_COPY
        MENUITEM "วาง(&P)\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "ลบ(&L)\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "ค้นหา(&F)...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "ค้นหาถัดไป(&N)\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "ค้นหาก่อนหน้า(&V)\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "แทนที่(&R)...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "ไปที่(&G)...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "เลือกทั้งหมด(&A)\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "เวลา/วันที่(&D)\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "รูปแบบ(&O)"
    BEGIN
        MENUITEM "ตัดคำ(&W)", ID_FORMAT_WRAP
        MENUITEM "แบบอักษร(&F)...", ID_FORMAT_FONT
    END
    POPUP "มุมมอง(&V)"
    BEGIN
        POPUP "ซูม(&Z)"
        BEGIN
            MENUITEM "ซูมเข้า(&I)\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "ซูมออก(&O)\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "คืนค่าการซูมเริ่มต้น(&R)\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "แถบสถานะ(&S)", ID_VIEW_STATUS
    END
    POPUP "วิธีใช้(&H)"
    BEGIN
        MENUITEM "เกี่ยวกับ Notepad Classic(&A)", ID_HELP_ABOUT
    END
END

