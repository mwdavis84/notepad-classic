LANGUAGE 10, 3

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N", ID_FILE_NEW
        MENUITEM "&Abrir...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Guardar\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Guardar c&omo...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Salir", ID_FILE_EXIT
    END
    POPUP "&Edición"
    BEGIN
        MENUITEM "&Deshacer\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cor&tar\tCtrl+X", ID_EDIT_CUT
        MENUITEM "&Copiar\tCtrl+C", ID_EDIT_COPY
        MENUITEM "&Pegar\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "&Eliminar\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Buscar...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "Buscar &siguiente\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "Buscar &anterior\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "&Reemplazar...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "&Ir a...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Se&leccionar todo\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "Hora y &fecha\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "F&ormato"
    BEGIN
        MENUITEM "&Ajuste de línea", ID_FORMAT_WRAP
        MENUITEM "&Fuente...", ID_FORMAT_FONT
    END
    POPUP "&Ver"
    BEGIN
        POPUP "&Zoom"
        BEGIN
            MENUITEM "&Acercar\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "Ale&jar\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "&Restaurar zoom predeterminado\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "&Barra de estado", ID_VIEW_STATUS
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Acerca de Notepad Classic", ID_HELP_ABOUT
    END
END

