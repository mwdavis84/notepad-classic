LANGUAGE 1, 3

IDR_MAIN_MENU MENU
BEGIN
    POPUP "ملف(&F)"
    BEGIN
        MENUITEM "جديد(&N)\tCtrl+N", ID_FILE_NEW
        MENUITEM "فتح(&O)...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "حفظ(&S)\tCtrl+S", ID_FILE_SAVE
        MENUITEM "حفظ باسم(&A)...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "طباعة(&P)...\tCtrl+P", ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "خروج(&X)", ID_FILE_EXIT
    END
    POPUP "تحرير(&E)"
    BEGIN
        MENUITEM "تراجع(&U)\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "قص(&T)\tCtrl+X", ID_EDIT_CUT
        MENUITEM "نسخ(&C)\tCtrl+C", ID_EDIT_COPY
        MENUITEM "لصق(&P)\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "حذف(&L)\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "بحث(&F)...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "بحث عن التالي(&N)\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "بحث عن السابق(&V)\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "استبدال(&R)...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "انتقال إلى(&G)...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "تحديد الكل(&A)\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "الوقت/التاريخ(&D)\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "تنسيق(&O)"
    BEGIN
        MENUITEM "التفاف الكلمات(&W)", ID_FORMAT_WRAP
        MENUITEM "خط(&F)...", ID_FORMAT_FONT
    END
    POPUP "عرض(&V)"
    BEGIN
        POPUP "تكبير/تصغير(&Z)"
        BEGIN
            MENUITEM "تكبير(&I)\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "تصغير(&O)\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "استعادة التكبير الافتراضي(&R)\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "شريط الحالة(&S)", ID_VIEW_STATUS
    END
    POPUP "مساعدة(&H)"
    BEGIN
        MENUITEM "حول Notepad Classic(&A)", ID_HELP_ABOUT
    END
END

