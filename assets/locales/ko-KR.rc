LANGUAGE 18, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "새로 만들기(&N)\tCtrl+N", ID_FILE_NEW
        MENUITEM "열기(&O)...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "저장(&S)\tCtrl+S", ID_FILE_SAVE
        MENUITEM "다른 이름으로 저장(&A)...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)", ID_FILE_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "실행 취소(&U)\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "잘라내기(&T)\tCtrl+X", ID_EDIT_CUT
        MENUITEM "복사(&C)\tCtrl+C", ID_EDIT_COPY
        MENUITEM "붙여넣기(&P)\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "삭제(&L)\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "찾기(&F)...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "다음 찾기(&N)\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "이전 찾기(&V)\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "바꾸기(&R)...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "이동(&G)...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "모두 선택(&A)\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "시간/날짜(&D)\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "서식(&O)"
    BEGIN
        MENUITEM "자동 줄 바꿈(&W)", ID_FORMAT_WRAP
        MENUITEM "글꼴(&F)...", ID_FORMAT_FONT
    END
    POPUP "보기(&V)"
    BEGIN
        POPUP "확대/축소(&Z)"
        BEGIN
            MENUITEM "확대(&I)\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "축소(&O)\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "기본 확대/축소 복원(&R)\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "상태 표시줄(&S)", ID_VIEW_STATUS
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "Notepad Classic 정보(&A)", ID_HELP_ABOUT
    END
END

STRINGTABLE
BEGIN
    IDS_APP_NAME "Notepad Classic"
    IDS_UNTITLED "제목 없음"
    IDS_WINDOW_TITLE "%1 - Notepad Classic"
    IDS_SAVE_CHANGES "%1의 변경 내용을 저장하시겠습니까?"
    IDS_CREATE_MISSING_FILE "%1 파일을 찾을 수 없습니다.\n\n새 파일을 만드시겠습니까?"
    IDS_COMMAND_LINE_NOT_FILE "명령줄 경로가 파일이 아닙니다:\n\n%1"
    IDS_OPEN_FILE_FAILED "파일을 열 수 없습니다:\n\n%1"
    IDS_SAVE_FILE_FAILED "파일을 저장할 수 없습니다:\n\n%1"
