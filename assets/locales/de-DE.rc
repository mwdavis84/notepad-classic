LANGUAGE 7, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Datei"
    BEGIN
        MENUITEM "&Neu\tCtrl+N", ID_FILE_NEW
        MENUITEM "&Öffnen...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Speichern\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Speichern &unter...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Beenden", ID_FILE_EXIT
    END
    POPUP "&Bearbeiten"
    BEGIN
        MENUITEM "&Rückgängig\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "&Ausschneiden\tCtrl+X", ID_EDIT_CUT
        MENUITEM "&Kopieren\tCtrl+C", ID_EDIT_COPY
        MENUITEM "&Einfügen\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "&Löschen\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Suchen...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "&Weitersuchen\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "&Vorheriges suchen\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "Erse&tzen...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "&Gehe zu...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Alles &markieren\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "Uhrzeit/&Datum\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "F&ormat"
    BEGIN
        MENUITEM "&Zeilenumbruch", ID_FORMAT_WRAP
        MENUITEM "&Schriftart...", ID_FORMAT_FONT
    END
    POPUP "&Ansicht"
    BEGIN
        MENUITEM "&Statusleiste", ID_VIEW_STATUS
    END
    POPUP "&Hilfe"
    BEGIN
        MENUITEM "&Info über Notepad Classic", ID_HELP_ABOUT
    END
END

