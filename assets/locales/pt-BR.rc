LANGUAGE 22, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Arquivo"
    BEGIN
        MENUITEM "&Novo\tCtrl+N", ID_FILE_NEW
        MENUITEM "&Abrir...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Salvar\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Salvar &como...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Sai&r", ID_FILE_EXIT
    END
    POPUP "&Editar"
    BEGIN
        MENUITEM "&Desfazer\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "&Recortar\tCtrl+X", ID_EDIT_CUT
        MENUITEM "&Copiar\tCtrl+C", ID_EDIT_COPY
        MENUITEM "C&olar\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "Excl&uir\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Localizar...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "Localizar &próxima\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "Localizar &anterior\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "&Substituir...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "&Ir para...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Selecionar &tudo\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "&Hora/data\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "F&ormatar"
    BEGIN
        MENUITEM "&Quebra automática de linha", ID_FORMAT_WRAP
        MENUITEM "&Fonte...", ID_FORMAT_FONT
    END
    POPUP "E&xibir"
    BEGIN
        POPUP "&Zoom"
        BEGIN
            MENUITEM "&Ampliar\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "&Reduzir\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "Restaurar zoom &padrão\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "&Barra de status", ID_VIEW_STATUS
    END
    POPUP "Aj&uda"
    BEGIN
        MENUITEM "&Sobre o Notepad Classic", ID_HELP_ABOUT
    END
END

