LANGUAGE 12, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Fichier"
    BEGIN
        MENUITEM "&Nouveau\tCtrl+N", ID_FILE_NEW
        MENUITEM "&Ouvrir...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Enregistrer\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Enregistrer &sous...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Quitter", ID_FILE_EXIT
    END
    POPUP "&Édition"
    BEGIN
        MENUITEM "&Annuler\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cou&per\tCtrl+X", ID_EDIT_CUT
        MENUITEM "&Copier\tCtrl+C", ID_EDIT_COPY
        MENUITEM "C&oller\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "&Supprimer\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Rechercher...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "Rechercher le su&ivant\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "Rechercher le pr&écédent\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "Re&mplacer...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "A&tteindre...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Sélectionner to&ut\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "&Heure/Date\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "F&ormat"
    BEGIN
        MENUITEM "&Retour automatique à la ligne", ID_FORMAT_WRAP
        MENUITEM "&Police...", ID_FORMAT_FONT
    END
    POPUP "&Affichage"
    BEGIN
        MENUITEM "&Barre d'état", ID_VIEW_STATUS
    END
    POPUP "A&ide"
    BEGIN
        MENUITEM "À &propos de Notepad Classic", ID_HELP_ABOUT
    END
END

