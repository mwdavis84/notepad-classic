LANGUAGE 17, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新規(&N)\tCtrl+N", ID_FILE_NEW
        MENUITEM "開く(&O)...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "上書き保存(&S)\tCtrl+S", ID_FILE_SAVE
        MENUITEM "名前を付けて保存(&A)...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "印刷(&P)...\tCtrl+P", ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)", ID_FILE_EXIT
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "元に戻す(&U)\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "切り取り(&T)\tCtrl+X", ID_EDIT_CUT
        MENUITEM "コピー(&C)\tCtrl+C", ID_EDIT_COPY
        MENUITEM "貼り付け(&P)\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "削除(&L)\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "検索(&F)...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "次を検索(&N)\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "前を検索(&V)\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "置換(&R)...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "行へ移動(&G)...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "すべて選択(&A)\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "日付と時刻(&D)\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "書式(&O)"
    BEGIN
        MENUITEM "右端で折り返す(&W)", ID_FORMAT_WRAP
        MENUITEM "フォント(&F)...", ID_FORMAT_FONT
    END
    POPUP "表示(&V)"
    BEGIN
        POPUP "ズーム(&Z)"
        BEGIN
            MENUITEM "拡大(&I)\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "縮小(&O)\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "既定のズームに戻す(&R)\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "ステータス バー(&S)", ID_VIEW_STATUS
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "Notepad Classic のバージョン情報(&A)", ID_HELP_ABOUT
    END
END

STRINGTABLE
BEGIN
    IDS_APP_NAME "Notepad Classic"
    IDS_UNTITLED "無題"
    IDS_WINDOW_TITLE "%1 - Notepad Classic"
    IDS_SAVE_CHANGES "%1 への変更内容を保存しますか?"
