LANGUAGE 31, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Dosya"
    BEGIN
        MENUITEM "&Yeni\tCtrl+N", ID_FILE_NEW
        MENUITEM "&Aç...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Kaydet\tCtrl+S", ID_FILE_SAVE
        MENUITEM "&Farklı Kaydet...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Ya&zdır...\tCtrl+P", ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "&Çık", ID_FILE_EXIT
    END
    POPUP "D&üzenle"
    BEGIN
        MENUITEM "&Geri Al\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "&Kes\tCtrl+X", ID_EDIT_CUT
        MENUITEM "K&opyala\tCtrl+C", ID_EDIT_COPY
        MENUITEM "&Yapıştır\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "&Sil\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Bul...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "Son&rakini Bul\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "Ö&ncekini Bul\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "&Değiştir...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "G&it...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Tümünü S&eç\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "Saat/&Tarih\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "Bi&çim"
    BEGIN
        MENUITEM "&Sözcük Kaydır", ID_FORMAT_WRAP
        MENUITEM "&Yazı Tipi...", ID_FORMAT_FONT
    END
    POPUP "&Görünüm"
    BEGIN
        POPUP "&Yakınlaştırma"
        BEGIN
            MENUITEM "Ya&kınlaştır\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "&Uzaklaştır\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "&Varsayılan Yakınlaştırmayı Geri Yükle\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "Durum &Çubuğu", ID_VIEW_STATUS
    END
    POPUP "&Yardım"
    BEGIN
        MENUITEM "Notepad Classic &Hakkında", ID_HELP_ABOUT
    END
END

