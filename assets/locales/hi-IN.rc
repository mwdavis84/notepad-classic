LANGUAGE 57, 1

IDR_MAIN_MENU MENU
BEGIN
    POPUP "फ़ाइल(&F)"
    BEGIN
        MENUITEM "नया(&N)\tCtrl+N", ID_FILE_NEW
        MENUITEM "खोलें(&O)...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "सहेजें(&S)\tCtrl+S", ID_FILE_SAVE
        MENUITEM "इस रूप में सहेजें(&A)...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "प्रिंट करें(&P)...\tCtrl+P", ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "बाहर निकलें(&X)", ID_FILE_EXIT
    END
    POPUP "संपादित करें(&E)"
    BEGIN
        MENUITEM "पूर्ववत करें(&U)\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "काटें(&T)\tCtrl+X", ID_EDIT_CUT
        MENUITEM "प्रतिलिपि बनाएँ(&C)\tCtrl+C", ID_EDIT_COPY
        MENUITEM "चिपकाएँ(&P)\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "हटाएँ(&L)\tDel", ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "ढूँढें(&F)...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "अगला ढूँढें(&N)\tF3", ID_EDIT_FIND_NEXT
        MENUITEM "पिछला ढूँढें(&V)\tShift+F3", ID_EDIT_FIND_PREVIOUS
        MENUITEM "बदलें(&R)...\tCtrl+H", ID_EDIT_REPLACE
        MENUITEM "पंक्ति पर जाएँ(&G)...\tCtrl+G", ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "सभी चुनें(&A)\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "समय/दिनांक(&D)\tF5", ID_EDIT_TIME_DATE
    END
    POPUP "प्रारूप(&O)"
    BEGIN
        MENUITEM "शब्द लपेटें(&W)", ID_FORMAT_WRAP
        MENUITEM "फ़ॉन्ट(&F)...", ID_FORMAT_FONT
    END
    POPUP "देखें(&V)"
    BEGIN
        POPUP "ज़ूम(&Z)"
        BEGIN
            MENUITEM "बड़ा करें(&I)\tCtrl++", ID_VIEW_ZOOM_IN
            MENUITEM "छोटा करें(&O)\tCtrl+-", ID_VIEW_ZOOM_OUT
            MENUITEM "डिफ़ॉल्ट ज़ूम पुनर्स्थापित करें(&R)\tCtrl+0", ID_VIEW_ZOOM_DEFAULT
        END
        MENUITEM "स्थिति पट्टी(&S)", ID_VIEW_STATUS
    END
    POPUP "मदद(&H)"
    BEGIN
        MENUITEM "Notepad Classic के बारे में(&A)", ID_HELP_ABOUT
    END
END

